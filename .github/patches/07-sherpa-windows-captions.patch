+/// Windows fallback backend for captions. The in-process whisper.cpp build can
+/// return its opaque `-6` encoder error on some PCs even with valid audio and
+/// models. sherpa-onnx is already shipped by Concat for TTS, and its Whisper
+/// ONNX backend is independent of whisper.cpp, so use it on Windows instead of
+/// retrying the same failing encoder over and over.
+#[cfg(windows)]
+fn ensure_sherpa_whisper_model(
+    dirs: &AppDirs,
+    cancel: &std::sync::atomic::AtomicBool,
+    mut report_percent: impl FnMut(i32),
+) -> Result<(), String> {
+    use std::sync::atomic::Ordering;
+
+    if sherpa_whisper_ready(dirs) {
+        return Ok(());
+    }
+
+    let parent = dirs.data.join("sherpa-whisper-models");
+    std::fs::create_dir_all(&parent)
+        .map_err(|error| format!("could not create {}: {error}", parent.display()))?;
+    let destination = parent.join(SHERPA_WHISPER_ID);
+    let archive = parent.join(format!("{SHERPA_WHISPER_ID}.tar.bz2.part"));
+    let staging = parent.join(format!(".staging-{SHERPA_WHISPER_ID}"));
+    let _ = std::fs::remove_file(&archive);
+    let _ = std::fs::remove_dir_all(&staging);
+
+    let url = format!(
+        "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/{SHERPA_WHISPER_ID}.tar.bz2"
+    );
+    let mut download_progress = |progress: DownloadProgress| {
+        let percent = if progress.total > 0 {
+            ((progress.received as f64 / progress.total as f64) * 20.0)
+                .round()
+                .clamp(0.0, 20.0) as i32
+        } else {
+            0
+        };
+        report_percent(percent);
+    };
+    crate::download_to(
+        &url,
+        &archive,
+        SHERPA_WHISPER_ID,
+        SHERPA_WHISPER_ARCHIVE_ESTIMATE,
+        cancel,
+        &mut download_progress,
+    )?;
+    if cancel.load(Ordering::Relaxed) {
+        let _ = std::fs::remove_file(&archive);
+        return Err("transcription cancelled".to_owned());
+    }
+
+    std::fs::create_dir_all(&staging)
+        .map_err(|error| format!("could not create {}: {error}", staging.display()))?;
+    report_percent(21);
+    let file = std::fs::File::open(&archive)
+        .map_err(|error| format!("could not reopen caption model: {error}"))?;
+    let decoder = bzip2::read::BzDecoder::new(std::io::BufReader::new(file));
+    let mut tar = tar::Archive::new(decoder);
+    for entry in tar
+        .entries()
+        .map_err(|error| format!("could not read caption model archive: {error}"))?
+    {
+        if cancel.load(Ordering::Relaxed) {
+            let _ = std::fs::remove_file(&archive);
+            let _ = std::fs::remove_dir_all(&staging);
+            return Err("transcription cancelled".to_owned());
+        }
+        entry
+            .and_then(|mut entry| entry.unpack_in(&staging))
+            .map_err(|error| format!("could not unpack caption model: {error}"))?;
+    }
+
+    let unpacked = staging.join(SHERPA_WHISPER_ID);
+    let required = [
+        unpacked.join("tiny-encoder.int8.onnx"),
+        unpacked.join("tiny-decoder.int8.onnx"),
+        unpacked.join("tiny-tokens.txt"),
+    ];
+    if !required.iter().all(|path| path.is_file()) {
+        let _ = std::fs::remove_file(&archive);
+        let _ = std::fs::remove_dir_all(&staging);
+        return Err("caption model archive was incomplete".to_owned());
+    }
+
+    // Keep only the three files used by the editor. The release archive also
+    // contains float32 copies and test WAVs which would otherwise waste disk.
+    let compact = staging.join("compact");
+    std::fs::create_dir_all(&compact)
+        .map_err(|error| format!("could not prepare caption model: {error}"))?;
+    for path in &required {
+        let name = path.file_name().ok_or_else(|| "invalid caption model path".to_owned())?;
+        std::fs::copy(path, compact.join(name))
+            .map_err(|error| format!("could not prepare caption model: {error}"))?;
+    }
+    let _ = std::fs::remove_dir_all(&destination);
+    std::fs::rename(&compact, &destination)
+        .map_err(|error| format!("could not finish caption model: {error}"))?;
+    let _ = std::fs::remove_file(&archive);
+    let _ = std::fs::remove_dir_all(&staging);
+    report_percent(25);
+
+    if !sherpa_whisper_ready(dirs) {
+        return Err("caption model could not be prepared".to_owned());
+    }
+    Ok(())
+}
