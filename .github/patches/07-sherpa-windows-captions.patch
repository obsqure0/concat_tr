+#[cfg(windows)]
+const SHERPA_WHISPER_ID: &str = "sherpa-onnx-whisper-tiny";
+#[cfg(windows)]
+const SHERPA_WHISPER_ARCHIVE_ESTIMATE: u64 = 155_000_000;
