+#[cfg(windows)]
+fn sherpa_whisper_dir(dirs: &AppDirs) -> Result<PathBuf, String> {
+    let dir = dirs.data.join("sherpa-whisper-models").join(SHERPA_WHISPER_ID);
+    Ok(dir)
+}
+
+#[cfg(windows)]
+fn sherpa_whisper_files(dirs: &AppDirs) -> Result<(PathBuf, PathBuf, PathBuf), String> {
+    let dir = sherpa_whisper_dir(dirs)?;
+    Ok((
+        dir.join("tiny-encoder.int8.onnx"),
+        dir.join("tiny-decoder.int8.onnx"),
+        dir.join("tiny-tokens.txt"),
+    ))
+}
+
+#[cfg(windows)]
+fn sherpa_whisper_ready(dirs: &AppDirs) -> bool {
+    sherpa_whisper_files(dirs)
+        .map(|(encoder, decoder, tokens)| {
+            encoder.metadata().map(|m| m.len() > 5_000_000).unwrap_or(false)
+                && decoder.metadata().map(|m| m.len() > 20_000_000).unwrap_or(false)
+                && tokens.metadata().map(|m| m.len() > 100_000).unwrap_or(false)
+        })
+        .unwrap_or(false)
+}
