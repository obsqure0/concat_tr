+/// Turn recognizer prose into short on-screen phrases rather than one giant
+/// title. This is intentionally closer to social-video captioning: about 2-5
+/// words per card, with punctuation ending a card early.
+#[cfg(windows)]
+fn caption_phrases(text: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut current = Vec::new();
+    for word in text.split_whitespace() {
+        current.push(word);
+        let punctuation = word.ends_with('.')
+            || word.ends_with('!')
+            || word.ends_with('?')
+            || word.ends_with(',')
+            || word.ends_with(';')
+            || word.ends_with(':');
+        if current.len() >= 5 || (current.len() >= 2 && punctuation) {
+            out.push(current.join(" "));
+            current.clear();
+        }
+    }
+    if !current.is_empty() {
+        out.push(current.join(" "));
+    }
+    out
+}
