new file mode 100644
--- /dev/null
+++ b/engine/crates/concat-speech/src/subtitles.rs
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Oblivion contributors
+
+//! Portable subtitle parsing and timing. No model or native library required.
+
+/// A caption in seconds relative to its source.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Cue {
+    /// Inclusive start.
+    pub start: f64,
+    /// Exclusive end.
+    pub end: f64,
+    /// Plain text; line breaks are preserved.
+    pub text: String,
+}
+
+fn timestamp(value: &str) -> Option<f64> {
+    let fields: Vec<_> = value.trim().split([':', ',', '.']).collect();
+    if fields.len() != 4
+        || fields[3].len() != 3
+        || fields
+            .iter()
+            .any(|field| field.is_empty() || !field.bytes().all(|b| b.is_ascii_digit()))
+    {
+        return None;
+    }
+    let hours = fields[0].parse::<u32>().ok()?;
+    let minutes = fields[1].parse::<u32>().ok()?;
+    let seconds = fields[2].parse::<u32>().ok()?;
+    let millis = fields[3].parse::<u32>().ok()?;
+    (minutes < 60 && seconds < 60).then_some(
+        hours as f64 * 3600.0 + minutes as f64 * 60.0 + seconds as f64 + millis as f64 / 1000.0,
+    )
+}
+
+/// Read UTF-8 SRT, accepting BOM, CRLF and optional numeric cue indices.
+/// Reject the entire file on malformed input instead of importing half of it.
+pub fn parse_srt(input: &str) -> Result<Vec<Cue>, String> {
+    if input.len() > 8 * 1024 * 1024 {
+        return Err("SRT is larger than 8 MB".into());
+    }
+    let normalized = input
+        .trim_start_matches('\u{feff}')
+        .replace("\r\n", "\n")
+        .replace('\r', "\n");
+    let mut blocks: Vec<Vec<&str>> = Vec::new();
+    let mut block = Vec::new();
+    for line in normalized.lines() {
+        if line.trim().is_empty() {
+            if !block.is_empty() {
+                blocks.push(std::mem::take(&mut block));
+            }
+        } else {
+            block.push(line);
+        }
+    }
+    if !block.is_empty() {
+        blocks.push(block);
+    }
+    let mut cues = Vec::new();
+    for (index, block) in blocks.iter().enumerate() {
+        let fail = || format!("Invalid SRT cue {}", index + 1);
+        let timing = usize::from(!block[0].contains("-->"));
+        if timing == 1 && !block[0].trim().bytes().all(|b| b.is_ascii_digit()) {
+            return Err(fail());
+        }
+        let line = block.get(timing).ok_or_else(fail)?;
+        let (left, right) = line.split_once("-->").ok_or_else(fail)?;
+        let start = timestamp(left).ok_or_else(fail)?;
+        let end = timestamp(right).ok_or_else(fail)?;
+        let text = block.get(timing + 1..).ok_or_else(fail)?.join("\n");
+        if end <= start || text.trim().is_empty() {
+            return Err(fail());
+        }
+        cues.push(Cue { start, end, text });
+    }
+    if cues.is_empty() {
+        return Err("The SRT file contains no captions".into());
+    }
+    cues.sort_by(|a, b| a.start.total_cmp(&b.start));
+    Ok(cues)
+}
+
+/// Split long captions without losing words or exceeding the original interval.
+/// Timing is proportional to word count when individual word timing is absent.
+pub fn short_phrases(cue: Cue, max_words: usize) -> Vec<Cue> {
+    let words: Vec<_> = cue.text.split_whitespace().collect();
+    if words.is_empty() || !cue.start.is_finite() || !cue.end.is_finite() || cue.end <= cue.start {
+        return Vec::new();
+    }
+    let max_words = max_words.max(1);
+    if words.len() <= max_words {
+        return vec![cue];
+    }
+    let mut result = Vec::new();
+    for (index, chunk) in words.chunks(max_words).enumerate() {
+        let offset = index * max_words;
+        let start = cue.start + (cue.end - cue.start) * offset as f64 / words.len() as f64;
+        let end =
+            cue.start + (cue.end - cue.start) * (offset + chunk.len()) as f64 / words.len() as f64;
+        result.push(Cue {
+            start,
+            end,
+            text: chunk.join(" "),
+        });
+    }
+    result
+}
+
+/// Reassemble subword tokens into short phrases with the recognizer's own timing.
+/// Invalid or unavailable timing returns no cues so callers can use prose timing.
+pub fn timed_tokens(tokens: &[String], starts: &[f32], durations: &[f32], window: f64) -> Vec<Cue> {
+    if tokens.len() != starts.len()
+        || tokens.len() != durations.len()
+        || !window.is_finite()
+        || window <= 0.0
+    {
+        return Vec::new();
+    }
+    let mut result = Vec::new();
+    let mut text = String::new();
+    let mut start = 0.0;
+    let mut end = 0.0;
+    for (index, token) in tokens.iter().enumerate() {
+        let at = starts[index] as f64;
+        let length = durations[index] as f64;
+        if !at.is_finite() || !length.is_finite() || at < 0.0 || length < 0.0 {
+            return Vec::new();
+        }
+        if index > 0 && starts[index] < starts[index - 1] {
+            return Vec::new();
+        }
+        // Flush before the next word; do not cut a Turkish word between BPE tokens.
+        let new_word = token.chars().next().is_some_and(char::is_whitespace);
+        if new_word
+            && !text.trim().is_empty()
+            && (text.split_whitespace().count() >= 4 || at - end > 0.65)
+        {
+            if end > start {
+                result.push(Cue {
+                    start,
+                    end,
+                    text: text.trim().to_owned(),
+                });
+            }
+            text.clear();
+        }
+        if text.is_empty() {
+            start = at.min(window);
+        }
+        text.push_str(token);
+        end = (at + length).min(window);
+    }
+    if end > start && !text.trim().is_empty() {
+        result.push(Cue {
+            start,
+            end,
+            text: text.trim().to_owned(),
+        });
+    }
+    result
+}
+
+/// Intersect source-time SRT cues with a trimmed media window.
+pub fn in_window(cues: Vec<Cue>, source_start: f64, window: f64) -> Vec<Cue> {
+    if !source_start.is_finite() || !window.is_finite() || source_start < 0.0 || window <= 0.0 {
+        return Vec::new();
+    }
+    cues.into_iter()
+        .filter_map(|cue| {
+            let start = (cue.start - source_start).max(0.0);
+            let end = (cue.end - source_start).min(window);
+            (end > start).then_some(Cue {
+                start,
+                end,
+                text: cue.text,
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn turkish_bom_crlf_and_multiline_survive() {
+        let cues = parse_srt(
+            "\u{feff}1\r\n00:00:01,250 --> 00:00:02,500\r\nİşte elmas!\r\nÇok güzel.\r\n",
+        )
+        .unwrap();
+        assert_eq!(
+            cues,
+            vec![Cue {
+                start: 1.25,
+                end: 2.5,
+                text: "İşte elmas!\nÇok güzel.".into()
+            }]
+        );
+    }
+
+    #[test]
+    fn rejects_bad_timing_and_partial_imports() {
+        for text in [
+            "",
+            "1\n00:70:00,000 --> 00:70:01,000\nbad",
+            "1\n00:00:02,000 --> 00:00:01,000\nbad",
+            "1\n00:00:01,000 --> 00:00:02,000\ngood\n\n2\nbad",
+        ] {
+            assert!(parse_srt(text).is_err(), "{text}");
+        }
+    }
+
+    #[test]
+    fn trim_intersects_cues_and_rebases_to_clip() {
+        let cues = parse_srt("00:00:03,000 --> 00:00:06,000\nfirst\n\n00:00:08,000 --> 00:00:12,000\nlast\n\n00:00:14,000 --> 00:00:15,000\nout").unwrap();
+        let clipped = in_window(cues, 5.0, 5.0);
+        assert_eq!((clipped[0].start, clipped[0].end), (0.0, 1.0));
+        assert_eq!((clipped[1].start, clipped[1].end), (3.0, 5.0));
+        assert_eq!(clipped.len(), 2);
+    }
+
+    #[test]
+    fn short_phrases_preserve_words_and_final_boundary() {
+        let text = "Şimdi bu mağarada dört tane elmas buldum arkadaşlar";
+        let pieces = short_phrases(
+            Cue {
+                start: 2.0,
+                end: 3.0,
+                text: text.into(),
+            },
+            4,
+        );
+        assert_eq!(
+            pieces
+                .iter()
+                .map(|c| c.text.as_str())
+                .collect::<Vec<_>>()
+                .join(" "),
+            text
+        );
+        assert_eq!(pieces.first().unwrap().start, 2.0);
+        assert_eq!(pieces.last().unwrap().end, 3.0);
+        assert!(pieces.windows(2).all(|pair| pair[0].end == pair[1].start));
+    }
+
+    #[test]
+    fn token_timing_preserves_turkish_subwords_and_silence() {
+        let tokens =
+            [" Şim", "di", " elmas", " buldum", " arkadaşlar", " buraya"].map(String::from);
+        let cues = timed_tokens(&tokens, &[0.1, 0.2, 0.4, 0.6, 0.8, 3.0], &[0.1; 6], 4.0);
+        assert_eq!(cues[0].text, "Şimdi elmas buldum arkadaşlar");
+        assert_eq!(cues[1].text, "buraya");
+        assert!(cues[0].end < 1.0 && cues[1].start == 3.0);
+    }
+
+    #[test]
+    fn invalid_token_timing_uses_fallback() {
+        assert!(timed_tokens(&["hello".into()], &[f32::NAN], &[0.5], 1.0).is_empty());
+        assert!(timed_tokens(&["hello".into()], &[], &[], 1.0).is_empty());
+    }
+}
