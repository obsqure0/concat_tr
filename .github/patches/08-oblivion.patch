+            return;
+        };
+        if clip.reverse || clip.speed_curve.is_some() {
+            self.captions.message =
+                t("Generate captions before reversing or adding a speed curve.");
+            return;
+        }
+        let result = (|| {
+            use std::io::Read;
+            let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+            let mut text = String::new();
+            file.take(8 * 1024 * 1024 + 1)
+                .read_to_string(&mut text)
+                .map_err(|e| e.to_string())?;
+            concat_speech::subtitles::parse_srt(&text)
+        })();
+        match result {
+            Ok(cues) => {
+                let cues = concat_speech::subtitles::in_window(
+                    cues,
+                    clip.source_start,
+                    clip.duration * clip.speed,
+                );
+                if cues.is_empty() {
+                    self.captions.message = t(
+                        "No subtitles overlap this clip. SRT times must match the original media.",
+                    );
+                } else {
+                    self.insert_captions(&clip, cues);
+                }
+            }
+            Err(error) => self.captions.message = tf("Could not import SRT: {0}", &[&error]),
+        }
+    }
