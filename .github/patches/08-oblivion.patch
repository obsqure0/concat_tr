+// SPDX-License-Identifier: AGPL-3.0-or-later
+// SPDX-FileCopyrightText: 2026 Oblivion contributors
+
+//! Exercise the shipping decoder and caption backend on an actual speech WAV.
+use concat_host::AppDirs;
+use concat_speech::Transcriber;
+use concat_speech::transcribe::TranscribeRequest;
+
+fn main() -> Result<(), String> {
+    eprintln!("Starting Oblivion speech smoke test");
+    let path = std::env::args()
+        .nth(1)
+        .ok_or("Pass the JFK speech WAV path")?;
+    let root = std::env::temp_dir().join("oblivion-caption-smoke");
+    let dirs = AppDirs::under(&root);
+    let transcriber = Transcriber::new();
+    eprintln!("Preparing multilingual Base model");
+    transcriber.download_model(&dirs, "base", |_| {})?;
+    eprintln!("Model ready; decoding reference audio");
+    let request = TranscribeRequest {
+        path,
+        source_start: 0.0,
+        window: 11.0,
+        language: "en".into(),
+        model_id: "base".into(),
+    };
+    let captions = transcriber.transcribe(&dirs, &request, |progress| {
+        eprintln!("Caption progress: {progress}%");
+    })?;
+    let text = captions
+        .iter()
+        .map(|cue| cue.text.as_str())
+        .collect::<Vec<_>>()
+        .join(" ");
+    println!("{text}");
+    if !text.to_lowercase().contains("country") {
+        return Err("The speech backend did not recognize the reference recording".into());
+    }
+    if !captions
+        .iter()
+        .all(|cue| cue.start >= 0.0 && cue.end > cue.start && cue.end <= 11.001)
+    {
+        return Err("Caption timestamps escaped the selected media window".into());
+    }
+    if transcriber.is_busy() {
+        return Err("Caption job remained busy after completion".into());
+    }
+    println!(
+        "Actual speech transcription passed ({} captions)",
+        captions.len()
+    );
+    Ok(())
+}
