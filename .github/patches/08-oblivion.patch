+    /// Add editable, bounded text clips in one undo step.
+    fn insert_captions(&mut self, clip: &Clip, cues: Vec<concat_speech::subtitles::Cue>) {
+        if !clip.speed.is_finite() || clip.speed <= 0.0 {
+            return;
+        }
+        let offset_y = CAPTION_OFFSETS[self.captions.placement.min(2)];
+        let font_size = CAPTION_SIZES[self.captions.size.min(2)];
+        let mut style = TextStyle {
+            font_family: "Inter".to_owned(),
+            font_size,
+            font_weight: 700.0,
+            stroke_width: 0.0022,
+            stroke_color: "#000000".to_owned(),
+            shadow: true,
+            ..TextStyle::default()
+        };
+        match self.captions.style {
+            1 => {
+                style.font_weight = 800.0;
+                style.stroke_width = 0.0045;
+            }
+            2 => {
+                style.color = "#ffe14a".to_owned();
+                style.stroke_width = 0.0035;
+            }
+            3 => {
+                style.background = "#101020d9".to_owned();
+                style.stroke_width = 0.0;
+            }
+            _ => {}
+        }
+        let cues = concat_speech::subtitles::in_window(cues, 0.0, clip.duration * clip.speed);
+        let cues: Vec<_> = if self.captions.length == 1 {
+            cues.into_iter()
+                .flat_map(|cue| concat_speech::subtitles::short_phrases(cue, 4))
+                .collect()
+        } else {
+            cues
+        };
+        let commands: Vec<_> = cues
+            .into_iter()
+            .filter_map(|cue| {
+                let duration = (cue.end - cue.start) / clip.speed;
+                if cue.text.trim().is_empty() || duration < 1.0 / 60.0 {
+                    return None;
+                }
+                Some(Command::AddTextClip {
+                    track_id: None,
+                    start: clip.start + cue.start / clip.speed,
+                    style: Some(TextStyle {
+                        content: cue.text.trim().to_owned(),
+                        ..style.clone()
+                    }),
+                    duration: Some(duration),
+                    offset_y: Some(offset_y),
+                })
+            })
+            .collect();
+        let count = commands.len();
+        if count == 0 {
+            self.captions.message = t("Nothing was said in that clip");
+            return;
+        }
+        self.apply(Command::Batch { commands });
+        self.captions.open = false;
+        self.notify(&tf("Added {0} captions", &[&count]), false);
+    }
