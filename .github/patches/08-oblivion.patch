+#[cfg(windows)]
+fn transcribe_with_sherpa(
+    dirs: &AppDirs,
+    request: &TranscribeRequest,
+    samples: &[f32],
+    cancel: &std::sync::atomic::AtomicBool,
+    mut progress: impl FnMut(i32),
+) -> Result<Vec<Segment>, String> {
+    use std::sync::atomic::Ordering;
+
+    ensure_sherpa_whisper_model(dirs, cancel, |percent| progress(percent))?;
+    if cancel.load(Ordering::Relaxed) {
+        return Err("transcription cancelled".to_owned());
+    }
+    let (encoder, decoder, tokens) = sherpa_whisper_files(dirs)?;
+    let mut config = OfflineRecognizerConfig::default();
+    let language = match request.language.as_str() {
+        "" | "auto" => "",
+        other => other,
+    };
+    config.model_config.whisper = OfflineWhisperModelConfig {
+        encoder: Some(encoder.to_string_lossy().into_owned()),
+        decoder: Some(decoder.to_string_lossy().into_owned()),
+        language: Some(language.to_owned()),
+        task: Some("transcribe".to_owned()),
+        tail_paddings: -1,
+        enable_token_timestamps: true,
+        enable_segment_timestamps: false,
+    };
+    config.model_config.tokens = Some(tokens.to_string_lossy().into_owned());
+    config.model_config.provider = Some("cpu".to_owned());
+    config.model_config.num_threads = 2;
+    config.decoding_method = Some("greedy_search".to_owned());
+
+    let recognizer = OfflineRecognizer::create(&config)
+        .ok_or_else(|| "could not start the Windows caption recognizer".to_owned())?;
+
+    const RATE: usize = 16_000;
+    const CHUNK_SECONDS: usize = 8;
+    const CHUNK_SAMPLES: usize = RATE * CHUNK_SECONDS;
+    let total_chunks = samples.len().div_ceil(CHUNK_SAMPLES).max(1);
+    let mut segments = Vec::new();
+
+    for (index, chunk) in samples.chunks(CHUNK_SAMPLES).enumerate() {
+        if cancel.load(Ordering::Relaxed) {
+            return Err("transcription cancelled".to_owned());
+        }
+        let stream = recognizer.create_stream();
+        stream.accept_waveform(RATE as i32, chunk);
+        recognizer.decode(&stream);
+        if cancel.load(Ordering::Relaxed) {
+            return Err("transcription cancelled".to_owned());
+        }
+        let result = stream
+            .get_result()
+            .ok_or_else(|| "Windows caption recognizer returned no result".to_owned())?;
+        {
+            let chunk_start = (index * CHUNK_SAMPLES) as f64 / RATE as f64;
+            let chunk_duration = chunk.len() as f64 / RATE as f64;
+            let timed = result
+                .timestamps
+                .as_ref()
+                .zip(result.durations.as_ref())
+                .map(|(times, lengths)| {
+                    crate::subtitles::timed_tokens(&result.tokens, times, lengths, chunk_duration)
+                })
+                .unwrap_or_default();
+            if !timed.is_empty() {
+                segments.extend(timed.into_iter().map(|cue| Segment {
+                    start: chunk_start + cue.start,
+                    end: chunk_start + cue.end,
+                    text: cue.text,
+                }));
+            } else {
+                let phrases = caption_phrases(result.text.trim());
+                if !phrases.is_empty() {
+                    let chunk_start = (index * CHUNK_SAMPLES) as f64 / RATE as f64;
+                    let chunk_duration = chunk.len() as f64 / RATE as f64;
+                    let each = chunk_duration / phrases.len() as f64;
+                    for (phrase_index, text) in phrases.into_iter().enumerate() {
+                        let start = chunk_start + phrase_index as f64 * each;
+                        let end = (start + each).min(chunk_start + chunk_duration);
+                        if let Some(segment) = keep_segment(start, end, text) {
+                            segments.push(segment);
+                        }
+                    }
+                }
+            }
+        }
+        let done = index + 1;
+        let percent = 25 + ((done as f64 / total_chunks as f64) * 75.0).round() as i32;
+        progress(percent.clamp(25, 100));
+    }
+    progress(100);
+    Ok(segments)
+}
