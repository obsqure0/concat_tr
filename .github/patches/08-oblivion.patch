+    /// Import subtitles timed against the original media, respecting trim and speed.
+    pub fn captions_import_srt(&mut self, path: &Path) {
+        if self.captions.running {
+            return;
+        }
+        let Some(clip) = self
+            .captions
+            .clip
+            .as_ref()
+            .and_then(|id| self.clip(id))
+            .cloned()
