+/// Install only the three inference files, streaming the archive from HTTPS.
+/// This avoids storing the full archive, float32 copies and test recordings.
+#[cfg(windows)]
+fn ensure_sherpa_whisper_model(
+    dirs: &AppDirs,
+    cancel: &std::sync::atomic::AtomicBool,
+    mut report_percent: impl FnMut(i32),
+) -> Result<(), String> {
+    use std::io::Read;
+    use std::sync::atomic::AtomicBool;
+
+    struct ProgressReader<'a, R, F> {
+        inner: R,
+        cancel: &'a AtomicBool,
+        report: F,
+        received: u64,
+        last_report: u64,
+        total: u64,
+    }
+
+    impl<R: Read, F: FnMut(i32)> Read for ProgressReader<'_, R, F> {
+        fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+            if self.cancel.load(Ordering::Relaxed) {
+                // Interrupted is retried by io::copy; cancellation must be terminal.
+                return Err(std::io::Error::other("transcription cancelled"));
+            }
+            let count = self.inner.read(buffer)?;
+            self.received += count as u64;
+            if self.received - self.last_report >= 2 * 1024 * 1024 || count == 0 {
+                self.last_report = self.received;
+                let percent = (self.received as f64 / self.total.max(1) as f64 * 20.0)
+                    .clamp(0.0, 20.0) as i32;
+                (self.report)(percent);
+            }
+            Ok(count)
+        }
+    }
+
+    if sherpa_whisper_ready(dirs) {
+        return Ok(());
+    }
+    let parent = dirs.data.join("sherpa-whisper-models");
+    std::fs::create_dir_all(&parent).map_err(|error| error.to_string())?;
+    let destination = parent.join(SHERPA_WHISPER_ID);
+    let staging = parent.join(format!(".staging-{SHERPA_WHISPER_ID}"));
+    let _ = std::fs::remove_dir_all(&staging);
+    std::fs::create_dir_all(&staging).map_err(|error| error.to_string())?;
+
+    let outcome = (|| {
+        let url = format!(
+            "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/{SHERPA_WHISPER_ID}.tar.bz2"
+        );
+        let response = ureq::AgentBuilder::new()
+            .timeout_connect(std::time::Duration::from_secs(20))
+            .timeout_read(std::time::Duration::from_secs(30))
+            .build()
+            .get(&url)
+            .call()
+            .map_err(|error| format!("caption model download failed: {error}"))?;
+        let total = response.header("Content-Length")
+            .and_then(|value| value.parse::<u64>().ok())
+            .unwrap_or(SHERPA_WHISPER_ARCHIVE_ESTIMATE);
+        let reader = ProgressReader {
+            inner: response.into_reader(), cancel, report: &mut report_percent,
+            received: 0, last_report: 0, total,
+        };
+        let decoder = bzip2::read::BzDecoder::new(std::io::BufReader::new(reader));
+        let mut archive = tar::Archive::new(decoder);
+        let required = [
+            ("base-encoder.int8.onnx", 5_000_000),
+            ("base-decoder.int8.onnx", 20_000_000),
+            ("base-tokens.txt", 100_000),
+        ];
+        for entry in archive.entries().map_err(|error| error.to_string())? {
+            let mut entry = entry.map_err(|error| error.to_string())?;
+            let path = entry.path().map_err(|error| error.to_string())?.into_owned();
+            let Some((name, _)) = required.iter().find(|(name, _)| {
+                path == std::path::Path::new(SHERPA_WHISPER_ID).join(name)
+            }) else { continue; };
+            if !entry.header().entry_type().is_file() {
+                return Err("caption model archive contains an invalid file".to_owned());
+            }
+            let mut output = std::fs::File::create(staging.join(name))
+                .map_err(|error| format!("could not write caption model: {error}"))?;
+            std::io::copy(&mut entry, &mut output)
+                .map_err(|error| format!("caption model download interrupted: {error}"))?;
+        }
+        // Consume the compressed trailer as well, so a damaged archive is rejected.
+        let mut decoder = archive.into_inner();
+        std::io::copy(&mut decoder, &mut std::io::sink())
+            .map_err(|error| format!("caption model archive was damaged: {error}"))?;
+        drop(decoder);
+        report_percent(21);
+        if cancel.load(Ordering::Relaxed) {
+            return Err("transcription cancelled".to_owned());
+        }
+        if !required.iter().all(|(name, minimum)| {
+            staging.join(name).metadata().is_ok_and(|meta| meta.is_file() && meta.len() > *minimum)
+        }) {
+            return Err("caption model archive was incomplete".to_owned());
+        }
+        if destination.exists() {
+            std::fs::remove_dir_all(&destination).map_err(|error| error.to_string())?;
+        }
+        // Rename on the same filesystem; no second copy or half-installed model.
+        std::fs::rename(&staging, &destination)
+            .map_err(|error| format!("could not finish caption model: {error}"))?;
+        report_percent(25);
+        Ok(())
+    })();
+    if outcome.is_err() {
+        let _ = std::fs::remove_dir_all(&staging);
+    }
+    outcome
+}
