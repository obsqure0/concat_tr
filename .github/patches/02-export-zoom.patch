+/// (the root of the current drive), which standard users cannot write. Prefer
+/// USERPROFILE there and keep HOME as the portable fallback.
 fn home_folder(name: &str) -> String {
-    std::env::var("HOME")
-        .map(|home| format!("{home}/{name}"))
+    let home = std::env::var_os("USERPROFILE")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("HOME")
+                .filter(|value| !value.is_empty())
+                .map(PathBuf::from)
+        })
+        .or_else(|| {
+            let drive = std::env::var_os("HOMEDRIVE")?;
+            let path = std::env::var_os("HOMEPATH")?;
+            Some(PathBuf::from(drive).join(path))
+        });
+
+    let folder = if cfg!(target_os = "windows") && name == "Movies" {
+        // Explorer calls this known folder "Videos" even on translated
+        // Windows installations; the display name is localised separately.
+        "Videos"
+    } else {
+        name
+    };
+    home.map(|home| home.join(folder).to_string_lossy().into_owned())
         .unwrap_or_default()
 }
 
+/// A file-system safe export stem. The same conservative set works on every
+/// desktop and avoids Windows' reserved path punctuation in project names.
+fn export_stem(raw: &str) -> String {
+    let raw = raw.trim();
+    let raw = raw
+        .strip_suffix(".mp4")
+        .or_else(|| raw.strip_suffix(".MP4"))
+        .unwrap_or(raw);
+    let mut out: String = raw
+        .chars()
+        .map(|ch| {
+            if ch.is_control() || matches!(ch, '<' | '>' | ':' | '"' | '/' | '\\' | '|' | '?' | '*') {
+                '_'
+            } else {
+                ch
+            }
+        })
+        .collect();
+    out = out.trim().trim_matches('.').trim().to_owned();
+    if out.is_empty() {
+        t("Untitled")
+    } else {
+        out
+    }
+}
+
+/// CapCut-style "do not destroy the previous render" naming. If the chosen
+/// name is already there, use `name (2).mp4`, `name (3).mp4`, and so on.
+fn available_export_path(folder: &Path, stem: &str) -> PathBuf {
+    let first = folder.join(format!("{stem}.mp4"));
+    if !first.exists() {
+        return first;
+    }
+    for number in 2..10_000 {
+        let candidate = folder.join(format!("{stem} ({number}).mp4"));
+        if !candidate.exists() {
+            return candidate;
+        }
+    }
+    first
+}
